{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/(.*)",
      "dest": "https://relay-chat-backend-latest.onrender.com/api/$1"
    },
    {
      "src": "^/socket.io/(.*)",
      "dest": "https://relay-chat-backend-latest.onrender.com/$1"
    },
    {
      "src": "^(?!/api|/socket.io|/assets|/favicon.ico|/manifest.json).*$",
      "dest": "/index.html"
    }
  ]
}